<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archivo: E & M</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@400;600&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'paper': '#F0EFEA',
                        'ink': '#111111',
                        'divider': '#D9D8D2',
                        'accent': '#5C6656',
                    },
                    fontFamily: {
                        'cormorant': ['"Cormorant Garamond"', 'serif'],
                        'mono': ['"Space Mono"', 'monospace'],
                        'inter': ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Strict Resets & Editorial Baseline */
        * {
            border-radius: 0 !important;
            box-shadow: none !important;
        }
        
        body {
            background-color: #F0EFEA;
            color: #111111;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        ::selection {
            background-color: #5C6656;
            color: #F0EFEA;
        }

        /* Input Styles */
        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #111111;
        }

        /* Masonry Grid Setup */
        .masonry {
            column-count: 1;
            column-gap: 1rem;
        }
        @media (min-width: 768px) {
            .masonry { column-count: 2; }
        }
        @media (min-width: 1024px) {
            .masonry { column-count: 3; }
        }
        .masonry-item {
            break-inside: avoid;
            margin-bottom: 1rem;
            position: relative;
            border: 1px solid #D9D8D2;
        }
        .masonry-item img {
            width: 100%;
            display: block;
            filter: grayscale(100%) contrast(1.1);
            transition: filter 0.3s ease;
        }
        .masonry-item:hover img {
            filter: grayscale(0%) contrast(1);
        }

        /* Hide scrollbar for cleaner look */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F0EFEA;
            border-left: 1px solid #D9D8D2;
        }
        ::-webkit-scrollbar-thumb {
            background: #D9D8D2;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #111111;
        }
    </style>
</head>
<body class="border-x border-divider max-w-[1600px] mx-auto min-h-screen flex flex-col">

    <!-- Cabecera Semántica -->
    <header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-sm border-b border-divider flex justify-between items-center px-4 md:px-8 py-4">
        <div class="font-cormorant text-2xl font-bold tracking-tight">E&M</div>
        <nav class="flex items-center gap-6">
            <a href="#itinerario" class="font-mono uppercase text-xs tracking-widest text-ink hover:text-accent transition-colors hidden md:block">Itinerario</a>
            <a href="#archivo" class="font-mono uppercase text-xs tracking-widest text-ink hover:text-accent transition-colors hidden md:block">El Archivo</a>
            <button id="btn-open-rsvp" class="border border-ink px-6 py-2 font-mono uppercase text-xs tracking-widest hover:bg-ink hover:text-paper transition-colors">
                Confirmar Asistencia
            </button>
        </nav>
    </header>

    <!-- Contenido Principal Semántico -->
    <main class="flex-grow flex flex-col">
        
        <!-- Hero Section -->
        <section class="flex-grow flex flex-col border-b border-divider">
            <div class="flex-grow flex flex-col justify-center px-4 md:px-16 py-20 lg:py-32">
                <h1 class="font-cormorant text-6xl md:text-[10rem] lg:text-[12rem] leading-[0.8] tracking-tighter uppercase break-words">
                    Elena &<br>Mateo
                </h1>
            </div>
            
            <!-- Metadata Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 border-t border-divider">
                <div class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-divider">
                    <div class="font-mono text-accent text-xs tracking-widest uppercase mb-3">Fecha de Registro</div>
                    <div class="font-inter text-xl uppercase">24 Octubre 2026</div>
                </div>
                <div class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-divider">
                    <div class="font-mono text-accent text-xs tracking-widest uppercase mb-3">Hora de Convocatoria</div>
                    <div class="font-inter text-xl uppercase">16:00 Horas</div>
                </div>
                <div class="p-6 md:p-8 flex flex-col justify-center">
                    <div class="font-mono text-accent text-xs tracking-widest uppercase mb-3">Coordenadas</div>
                    <!-- Enlace a fuente externa -->
                    <a href="https://maps.google.com/?q=Valle+de+Guadalupe+Mexico" target="_blank" rel="noopener noreferrer" class="font-inter text-xl uppercase hover:text-accent flex items-center gap-2 group">
                        Hacienda Las Lomas
                        <span class="font-mono text-sm border border-ink px-2 py-1 group-hover:bg-ink group-hover:text-paper transition-colors">MAPA &#8599;</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Itinerario Section (Lista Requerida) -->
        <section id="itinerario" class="border-b border-divider grid grid-cols-1 md:grid-cols-2">
            <div class="p-8 md:p-16 border-b md:border-b-0 md:border-r border-divider">
                <h2 class="font-cormorant text-4xl md:text-6xl uppercase tracking-tighter mb-4">Secuencia del Evento</h2>
                <p class="font-mono text-xs uppercase tracking-widest text-accent">Programa Oficial de Protocolo</p>
            </div>
            <div class="p-8 md:p-16 flex items-center">
                <!-- Lista Desordenada -->
                <ul class="w-full flex flex-col space-y-6 font-inter">
                    <li class="flex justify-between items-end border-b border-divider pb-2 hover:border-ink transition-colors">
                        <span class="text-lg uppercase">Recepción y Cóctel</span>
                        <span class="font-mono text-sm text-accent">16:00 HRS</span>
                    </li>
                    <li class="flex justify-between items-end border-b border-divider pb-2 hover:border-ink transition-colors">
                        <span class="text-lg uppercase">Ceremonia Civil</span>
                        <span class="font-mono text-sm text-accent">17:30 HRS</span>
                    </li>
                    <li class="flex justify-between items-end border-b border-divider pb-2 hover:border-ink transition-colors">
                        <span class="text-lg uppercase">Banquete y Celebración</span>
                        <span class="font-mono text-sm text-accent">19:00 HRS</span>
                    </li>
                </ul>
            </div>
        </section>

        <!-- Archivo Visual / Baúl de Fotos (Imágenes Requeridas) -->
        <section id="archivo" class="p-8 md:p-16 bg-paper">
            <div class="mb-12 flex justify-between items-end">
                <div>
                    <h2 class="font-cormorant text-4xl md:text-6xl uppercase tracking-tighter mb-2">Baúl de Fotos</h2>
                    <p class="font-mono text-xs uppercase tracking-widest text-accent">Registro Gráfico (Extractos)</p>
                </div>
                <button class="border border-ink bg-ink text-paper px-6 py-2 font-mono uppercase text-xs tracking-widest hover:bg-paper hover:text-ink transition-colors hidden md:block">
                    APORTAR FOTO
                </button>
            </div>

            <!-- Grilla Estricta Asimétrica -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Imagen 1 -->
                <article class="border border-divider p-2 group bg-white/50">
                    <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=1000&auto=format&fit=crop" alt="Anillos de Boda" class="w-full h-auto object-cover aspect-[3/4] filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700">
                    <div class="mt-3 font-mono text-[10px] uppercase text-ink/70 flex justify-between border-t border-divider pt-2">
                        <span>REF: ANILLOS_01</span>
                        <span>DOC.01</span>
                    </div>
                </article>
                
                <!-- Imagen 2 -->
                <article class="border border-divider p-2 group bg-white/50 lg:mt-12">
                    <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1000&auto=format&fit=crop" alt="Detalle del vestido" class="w-full h-auto object-cover aspect-square filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700">
                    <div class="mt-3 font-mono text-[10px] uppercase text-ink/70 flex justify-between border-t border-divider pt-2">
                        <span>REF: VESTIDO_02</span>
                        <span>DOC.02</span>
                    </div>
                </article>

                <!-- Imagen 3 -->
                <article class="border border-divider p-2 group bg-white/50 md:col-span-2 lg:col-span-1 lg:-mt-6">
                    <img src="https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?q=80&w=1000&auto=format&fit=crop" alt="Mesa del Banquete" class="w-full h-auto object-cover aspect-[4/3] lg:aspect-[3/4] filter grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700">
                    <div class="mt-3 font-mono text-[10px] uppercase text-ink/70 flex justify-between border-t border-divider pt-2">
                        <span>REF: MESA_03</span>
                        <span>DOC.03</span>
                    </div>
                </article>
            </div>
            
            <button class="w-full mt-6 border border-ink bg-ink text-paper px-6 py-4 font-mono uppercase text-xs tracking-widest hover:bg-paper hover:text-ink transition-colors md:hidden">
                APORTAR FOTO AL BAÚL
            </button>
        </section>
    </main>

    <!-- Pie de página semántico -->
    <footer class="border-t border-divider p-8 flex flex-col md:flex-row justify-between items-center gap-4 bg-paper font-mono text-xs uppercase tracking-widest text-ink">
        <span>Documento Oficial E&M &copy; 2026</span>
        <span>Archivo Clasificado</span>
    </footer>

    <!-- Modal Interactivo (JS) -->
    <div id="modal-rsvp" class="fixed inset-0 z-50 bg-paper/95 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="bg-paper border border-ink w-full max-w-lg shadow-none">
            <div class="flex justify-between items-center p-4 border-b border-divider">
                <h3 class="font-mono uppercase text-sm tracking-widest text-ink">Formulario de Asistencia</h3>
                <button id="btn-close-rsvp" class="font-mono text-xl leading-none hover:text-accent">&times;</button>
            </div>
            <div class="p-8 font-inter text-center">
                <p class="mb-6 uppercase text-sm">Ingrese sus credenciales de invitado para confirmar su asistencia.</p>
                <div class="border border-dashed border-divider p-8 font-mono text-xs text-accent">
                    MÓDULO DE FORMULARIO ESTÁTICO
                </div>
            </div>
        </div>
    </div>

    <!-- Vanilla JS para Interacciones Básicas -->
    <script>
        const modalRSVP = document.getElementById('modal-rsvp');
        const btnOpenRSVP = document.getElementById('btn-open-rsvp');
        const btnCloseRSVP = document.getElementById('btn-close-rsvp');

        // Abrir modal
        btnOpenRSVP.addEventListener('click', () => {
            modalRSVP.classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Evitar scroll
        });

        // Cerrar modal
        const closeModal = () => {
            modalRSVP.classList.add('hidden');
            document.body.style.overflow = '';
        };

        btnCloseRSVP.addEventListener('click', closeModal);
        
        // Cerrar al clickear fuera
        modalRSVP.addEventListener('click', (e) => {
            if (e.target === modalRSVP) closeModal();
        });
    </script>
</body>
</html>